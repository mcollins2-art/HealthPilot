ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=healthpilot;Username=postgres;Password=postgres
Security__ApiKey=
Security__ApiKeyHeader=X-API-Key
Security__TenantHeader=X-Tenant-Id
Security__ApiKeys__0__Name=estimate-client
Security__ApiKeys__0__Key=replace-with-secure-random-key
Security__ApiKeys__0__Scopes__0=estimate:read
Security__ApiKeys__1__Name=ingestion-worker
Security__ApiKeys__1__Key=replace-with-secure-random-key
Security__ApiKeys__1__Scopes__0=ingestion:write
RateLimiting__PermitLimit=120
RateLimiting__WindowSeconds=60
Ingestion__AllowedRootPath=
Ingestion__BatchSize=5000
Ingestion__CheckpointRetentionHours=168
